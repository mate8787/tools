rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reference copy of the rules published in the Firebase console.
    // The real email addresses and author ID are kept only in the console,
    // not in this public repo.
    function ok() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ALLOWED_EMAIL_1', 'ALLOWED_EMAIL_2', 'ALLOWED_EMAIL_3'];
    }

    // daily food / poop / exercise entries
    match /days/{day} {
      allow read, write: if ok();
    }

    // household ledger (가계부) entries
    match /expenses/{id} {
      allow read, write: if ok();
    }

    // which foods are included in / left out of menu suggestions
    match /settings/{id} {
      allow read, write: if ok();
    }

    // short messages: everyone allowed can read, only the author can post or delete
    match /messages/{id} {
      allow read: if ok();
      allow create, update, delete: if ok() && request.auth.uid == 'AUTHOR_UID';
    }

    // comments on messages: everyone allowed can read and comment as themselves;
    // a comment can be removed by whoever wrote it or by the message author
    match /comments/{id} {
      allow read: if ok();
      allow create: if ok() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if ok() && (resource.data.authorUid == request.auth.uid || request.auth.uid == 'AUTHOR_UID');
    }

    // which messages each person has opened, private to that person
    match /reads/{uid} {
      allow read, write: if ok() && request.auth.uid == uid;
    }
  }
}
